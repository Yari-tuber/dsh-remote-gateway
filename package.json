{
  "name": "dsh-remote-gateway",
  "version": "0.1.0",
  "description": "One-click authenticated phone access for DeepSeek Harness through a managed Cloudflare Quick Tunnel",
  "homepage": "https://github.com/Yari-tuber/dsh-remote-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yari-tuber/dsh-remote-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/Yari-tuber/dsh-remote-gateway/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "prepare": "tsdown --config tsdown.prepare.config.ts",
    "build": "pnpm run typecheck && pnpm run prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run prepare && git diff --check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "tar": "^7.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.30.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
